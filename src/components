import React, { useMemo } from "react";
import { Calendar, Clock, MapPin } from "lucide-react";

type Shoot = {
  id: string;
  client_name: string;
  shoot_type: string;
  date: string;
  time?: string;
  location?: string;
  status: string;
};

type TodayPanelProps = {
  shoots: Shoot[];
  onOpenCalendar?: () => void;
};

const getShootEmoji = (shootType: string) => {
  const type = shootType.toLowerCase();

  if (type.includes("volleyball")) return "🏐";
  if (type.includes("basketball")) return "🏀";
  if (type.includes("wedding")) return "👰";
  if (type.includes("media")) return "📸";
  if (type.includes("portrait")) return "🧑";
  if (type.includes("event")) return "🎉";
  if (type.includes("product")) return "📦";

  return "📷";
};

const TodayPanel: React.FC<TodayPanelProps> = ({
  shoots,
  onOpenCalendar,
}) => {
  const today = new Date().toLocaleDateString("en-CA");

  const todayShoots = useMemo(() => {
    return shoots
      .filter((shoot) => shoot.date === today)
      .sort((a, b) => {
        const timeA = a.time || "00:00";
        const timeB = b.time || "00:00";

        return timeA.localeCompare(timeB);
      });
  }, [shoots, today]);

  return (
    <section className="bg-slate-800 border border-slate-700 rounded-2xl p-4">
      <div className="flex items-center justify-between gap-3 mb-4">
        <div>
          <h2 className="text-lg font-bold text-white">
            🟢 {todayShoots.length}{" "}
            {todayShoots.length === 1 ? "Shoot Today" : "Shoots Today"}
          </h2>

          <p className="text-xs text-slate-400 mt-1">
            Your schedule for today
          </p>
        </div>

        {onOpenCalendar && (
          <button
            type="button"
            onClick={onOpenCalendar}
            className="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-xs font-semibold text-white transition"
          >
            <Calendar className="w-4 h-4" />
            Open Calendar
          </button>
        )}
      </div>

      <div className="space-y-3">
        {todayShoots.length === 0 ? (
          <div className="bg-slate-900/60 border border-slate-700 rounded-xl p-5 text-center">
            <p className="text-sm font-medium text-slate-300">
              No shoots scheduled for today.
            </p>

            <p className="text-xs text-slate-500 mt-1">
              Your upcoming shoots will appear here.
            </p>
          </div>
        ) : (
          todayShoots.map((shoot) => (
            <article
              key={shoot.id}
              className="bg-slate-900/70 border border-slate-700 rounded-xl p-3 hover:border-indigo-500/60 transition"
            >
              <div className="flex items-start gap-3">
                <div className="min-w-[60px]">
                  <div className="inline-flex items-center gap-1 text-sm font-bold text-indigo-300">
                    <Clock className="w-3.5 h-3.5" />
                    {shoot.time || "--:--"}
                  </div>
                </div>

                <div className="flex-1 min-w-0">
                  <h3 className="font-semibold text-white truncate">
                    {shoot.client_name}
                  </h3>

                  <p className="text-sm text-slate-300 mt-1">
                    <span className="mr-1">
                      {getShootEmoji(shoot.shoot_type)}
                    </span>
                    {shoot.shoot_type}
                  </p>

                  {shoot.location && (
                    <p className="flex items-center gap-1 text-xs text-slate-500 mt-1">
                      <MapPin className="w-3.5 h-3.5" />
                      <span className="truncate">{shoot.location}</span>
                    </p>
                  )}
                </div>

                <div className="shrink-0">
                  <span
                    className={`px-2 py-1 rounded-md text-[10px] font-semibold border ${
                      shoot.status === "completed"
                        ? "bg-green-900/50 text-green-300 border-green-700"
                        : shoot.status === "cancelled"
                        ? "bg-red-900/50 text-red-300 border-red-700"
                        : "bg-blue-900/50 text-blue-300 border-blue-700"
                    }`}
                  >
                    {shoot.status === "completed"
                      ? "Completed"
                      : shoot.status === "cancelled"
                      ? "Cancelled"
                      : "Planned"}
                  </span>
                </div>
              </div>
            </article>
          ))
        )}
      </div>
    </section>
  );
};

export default TodayPanel;
